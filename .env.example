ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./risklab.db
JWT_SECRET_KEY=replace-with-a-generated-local-secret
SESSION_CACHE_TTL=30
USER_CONTEXT_CACHE_SECONDS=30
REQUEST_CONTEXT_CACHE_TTL=60
REQUEST_CONTEXT_LOG_LEVEL=INFO
TOKEN_ISSUER=deployguard-risk-lab
TOKEN_AUDIENCE=deployguard-api
ALLOWED_ORIGINS=["http://localhost:5173"]
